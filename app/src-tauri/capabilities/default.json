{
  "identifier": "default",
  "description": "Capabilities for the RipeClips main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "shell:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:8000" },
        { "url": "http://localhost:8000" }
      ]
    }
  ]
}
