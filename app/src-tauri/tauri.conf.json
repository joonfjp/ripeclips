{
  "productName": "RipeClips",
  "version": "0.1.0",
  "identifier": "com.ripeclips.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RipeClips",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "resources": {
      "../public/fonts/": "fonts/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
