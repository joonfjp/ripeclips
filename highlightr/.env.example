# Ripe Clips configuration
# Copy this file to `.env` and adjust the values for your setup.
# All variables are optional; the built-in defaults are shown below.

# ── LLM endpoint ──────────────────────────────────────────────────────────────
# Ripe Clips talks to any OpenAI-compatible API. It POSTs to
# `{LLM_BASE_URL}/chat/completions` using structured outputs
# (response_format = json_schema) and parses the JSON from the assistant message.
#
# Point this at whatever you control: a local server, OpenAI, OpenRouter, etc.
# The base URL should end in `/v1`.
LLM_BASE_URL=http://localhost:7777/v1

# Optional model name passed through to the backend. Leave unset when the
# gateway selects its own model.
# LLM_MODEL=your-model

# API key sent as `Authorization: Bearer <key>`. Leave unset for local backends
# that don't require auth. REQUIRED when using a hosted provider like OpenAI.
# LLM_API_KEY=sk-...
# LLM_REQUIRE_API_KEY=true

# Per-request timeout (seconds) for each chat completion call. Long episodes make
# many calls; raise this if your endpoint is slow. Default: 180.
LLM_TIMEOUT_SECONDS=180

# Transient HTTP/connection retries after the initial attempt.
LLM_MAX_RETRIES=2
LLM_RETRY_INITIAL_SECONDS=3
LLM_RETRY_MULTIPLIER=3
LLM_RETRY_MAX_SECONDS=60
LLM_RETRY_JITTER_SECONDS=0.5

# Independent discovery windows may run concurrently. Keep this at 1 for local
# backends that only process one generation efficiently.
LLM_MAX_CONCURRENCY=1

# Hard request guardrail. Ranking and metadata calls are automatically batched
# below this limit; an oversized individual discovery window fails clearly.
LLM_MAX_PROMPT_CHARS=120000

# Maximum candidates per global-ranking and metadata request.
LLM_RANKING_BATCH_SIZE=40
LLM_METADATA_BATCH_SIZE=8

# In-memory API job retention/capacity and SRT upload guardrail.
JOB_TTL_SECONDS=86400
MAX_JOBS=500
MAX_SRT_UPLOAD_BYTES=10485760

# Comma-separated browser origins allowed by CORS.
# CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# ── Example: using OpenAI ─────────────────────────────────────────────────────
# Uncomment and set these (and LLM_API_KEY above) to use OpenAI instead of a
# local backend. Use a model that supports strict json_schema structured
# outputs (gpt-4o-2024-08-06 or newer, gpt-4o-mini, gpt-4.1, o-series).
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-2024-08-06

# ── Splicing (scripts/splice_highlights.py) ──────────────────────────────────
# Fallback root used to locate source media for older result JSON that does not
# carry a `_local` path block. Default: ./input relative to where you run it.
# HIGHLIGHTS_INPUT_ROOT=./input
